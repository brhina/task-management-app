# Server Environment Variables
# ─────────────────────────────────────────────────────────────────
# The canonical reference for ALL variables is /.env.example
# at the project root.
#
# Copy it to .env in the project root (used by docker-compose), or
# copy the server-relevant variables below to server/.env for local
# development without Docker.
#
# Variables consumed by the server:
#
#   NODE_ENV
#   PORT
#   CLIENT_URL
#   MONGO_URI
#   MONGODB_AI_DB
#   DISABLE_RAG_STREAMS     (optional)
#   REDIS_URL
#   JWT_SECRET
#   ADMIN_INVITE_TOKEN
#   AWS_S3_BUCKET           (optional)
#   AWS_ACCESS_KEY_ID       (optional)
#   AWS_SECRET_ACCESS_KEY   (optional)
#   AWS_REGION              (optional)
#   AWS_S3_PUBLIC_URL       (optional)
#   SMTP_HOST               (optional)
#   SMTP_PORT               (optional)
#   SMTP_USER               (optional)
#   SMTP_PASS               (optional)
#   SMTP_FROM               (optional)
#   SMTP_SECURE             (optional)
#   OPENAI_API_KEY          (optional)
#   OPENROUTER_API_KEY      (optional)
#   TELEBIRR_MODE
#   TELEBIRR_APP_ID
#   TELEBIRR_APP_KEY
#   TELEBIRR_SHORT_CODE
#   TELEBIRR_NOTIFY_SECRET
#   TELEBIRR_API_BASE       (optional)
#   SERVER_PUBLIC_URL       (optional)
#   TELEBIRR_ALLOW_SANDBOX_SIMULATION (optional)
