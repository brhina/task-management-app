# Server Environment Variables Configuration
# Copy this file to .env in the server directory

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database Connections
MONGO_URI=mongodb://localhost:27017/taskmanager
MONGODB_AI_DB=taskmanager_ai
# DISABLE_RAG_STREAMS=true

# Redis & Queueing
REDIS_URL=redis://localhost:6379

# Security Tokens (REQUIRED)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
ADMIN_INVITE_TOKEN=your_admin_invite_token_here

# S3 File Storage (Optional)
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_PUBLIC_URL=

# Email / SMTP Settings (Optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false

# AI Integrations (Optional)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
