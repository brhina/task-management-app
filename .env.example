# ==========================================
# Task Management Application — Environment Config
# Single source of truth for all environment variables.
#
# Usage:
#   cp .env.example .env   (project root — used by docker-compose)
#   server/.env.example and client/.env.example point back here.
# ==========================================

# ------------------------------------------
# Server & Application Setup
# ------------------------------------------
# Environment mode: development | production | test
NODE_ENV=development
# Port number for Express server
PORT=3001
# Client application public URL (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Main MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/taskmanager
# MongoDB Atlas (Production): mongodb+srv://<user>:<password>@cluster.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/taskmanager

# AI / RAG MongoDB database name (optional)
MONGODB_AI_DB=taskmanager_ai

# Set to true on standalone MongoDB instances without replica sets to disable change streams
# DISABLE_RAG_STREAMS=true

# ------------------------------------------
# Redis & Background Queue (BullMQ)
# ------------------------------------------
# Local Redis: redis://localhost:6379
# Managed Redis / TLS: rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Security & Authentication (REQUIRED)
# ------------------------------------------
# Secret key for JWT signing & verification.
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Secret token required to register initial administrator accounts
ADMIN_INVITE_TOKEN=your_admin_invite_token_here

# ------------------------------------------
# File Uploads / AWS S3 Configuration (Optional)
# If left unconfigured, files are saved to local ./uploads directory
# ------------------------------------------
# AWS_S3_BUCKET=my-task-manager-uploads
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AWS_REGION=us-east-1
# AWS_S3_PUBLIC_URL=https://my-task-manager-uploads.s3.amazonaws.com

# ------------------------------------------
# SMTP Email Service Configuration (Optional)
# If left unconfigured, email alerts will be logged to console in dev mode
# ------------------------------------------
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Task Manager <no-reply@yourdomain.com>"
# SMTP_SECURE=false

# ------------------------------------------
# AI & LLM Provider Keys (Optional)
# ------------------------------------------
# OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------
# Telebirr Billing (Ethio Telecom) — REQUIRED for paid plans
# ------------------------------------------
TELEBIRR_MODE=live
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_NOTIFY_SECRET=
# TELEBIRR_API_BASE=https://app.ethiomobilemoney.et:38443/apiaccess/payment/v1
# SERVER_PUBLIC_URL=https://api.yourdomain.com
# TELEBIRR_ALLOW_SANDBOX_SIMULATION=false

# ------------------------------------------
# Client-side Environment Variables (Vite)
# ------------------------------------------
# Base URL for API requests, baked into the JS bundle at build time.
# Local development:  http://localhost:3001
# Production:         https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3001
