# Recommended Production Environment Variables
# Copy these values into your Cloud Hosting Provider (Render, Railway, Fly.io, AWS) environment configuration.

# Application Settings
NODE_ENV=production
PORT=3001
CLIENT_URL=https://your-production-app.com

# Database Connection (MongoDB Atlas cluster URL recommended)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_name>.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGODB_AI_DB=taskmanager_ai

# Managed Redis URL (Upstash / Redis Cloud / ElastiCache)
REDIS_URL=rediss://default:<password>@<redis_host>:<port>

# Authentication Secrets (Use strong random strings, e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_64_byte_random_hex_string_in_production
ADMIN_INVITE_TOKEN=replace_with_a_secure_admin_invitation_token

# Optional S3 Storage
# AWS_S3_BUCKET=prod-task-manager-uploads
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_PUBLIC_URL=https://prod-task-manager-uploads.s3.amazonaws.com

# Optional SMTP Settings
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_FROM="Task Manager App <noreply@yourdomain.com>"
# SMTP_SECURE=true

# Optional AI API Key
# OPENAI_API_KEY=sk-proj-...
